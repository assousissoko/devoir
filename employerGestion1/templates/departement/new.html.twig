{% extends 'base.html.twig' %}

{% block title %}Nouveau Département{% endblock %}

{% block body %}
    <h1>Enregistrer un nouveau département</h1>

    {# Le lien vers l'index pour le retour #}
    <p><a href="{{ path('app_departement_index') }}">Retour à la liste</a></p>

    {# Le formulaire est rendu ici #}
    {{ form_start(form) }}
        {{ form_row(form.nom) }} 
        {{ form_row(form.isActive) }}
        {# Nous masquons les champs createAt et updateAt car ils sont gérés automatiquement #}
        {# Si vous avez d'autres champs, utilisez {{ form_widget(form) }} ou listez-les un par un #}
        
        <button class="btn btn-success mt-3">Enregistrer</button>
    {{ form_end(form) }}
{% endblock %}