{% extends 'base.html.twig' %}

{% block title %}Liste des Départements{% endblock %}

{% block body %}
    
    <div class="card shadow p-4 mx-auto" style="border-radius: 15px; max-width: 1000px;">
        
        {# EN-TÊTE AVEC BOUTON AJOUTER #}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="h3">Liste des Départements (GES EMP)</h1>
            
            <a href="#" class="btn btn-custom-blue btn-sm">
               + Ajouter un Département
            </a>
        </div>

        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th style="width: 15%;">ID</th>
                    <th style="width: 25%;">Nom</th>
                    <th style="width: 15%;">Actif</th>
                    <th style="width: 25%;">Créé le</th>
                    <th style="width: 15%;" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
            {% for departement in departements %}
                <tr>
                    <td>{{ departement.id }}</td>
                    <td>{{ departement.name }}</td>
                    <td>
                        {% set badge_color = departement.isActive ? 'success' : 'danger' %}
                        <span class="badge text-bg-{{ badge_color }}">
                            {{ departement.isActive ? 'Oui' : 'Non' }}
                        </span>
                    </td>
                    <td>{{ departement.createAt|date('d/m/Y H:i:s') }}</td>
                    <td class="text-center">

                        {# Icône en forme d'oeil pour voir la liste des employés. Ajouter le Route vers les employés plus tard #}
                        <a href="#" class="btn btn-outline-info btn-sm me-1" title="Voir les employés">
                            <i class="fa-solid fa-eye"></i> 
                        </a>

                        {# Icône en forme de crayon pour modifier ue département #}
                        <a href="#" class="btn btn-outline-secondary btn-sm" title="Modifier le département">
                            <i class="fa-solid fa-pencil"></i>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5">Aucun département trouvé.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}